        <!-- Transaction sequence table -->
        <mxCell id="seq" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;arcSize=3;spacing=12;" value="&lt;b style=&quot;font-size:14px&quot;&gt;Workflow: one chest X-ray, registration to AdvaPACS&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;table cellpadding=&quot;3&quot; style=&quot;border-collapse:collapse;font-size:11px&quot;&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;#&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Transaction&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;From → To&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Protocol · port · AE&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Status&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;①&lt;/td&gt;&lt;td&gt;Register patient (ID, name, age, gender)&lt;/td&gt;&lt;td&gt;Health worker → qTrack UI&lt;/td&gt;&lt;td&gt;HTTP :3000&lt;/td&gt;&lt;td&gt;working&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;②&lt;/td&gt;&lt;td&gt;Create worklist item (REGISTERED)&lt;/td&gt;&lt;td&gt;qTrack UI → MWL server&lt;/td&gt;&lt;td&gt;HTTP POST /patient/add :9002&lt;/td&gt;&lt;td&gt;working&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;③&lt;/td&gt;&lt;td&gt;Query worklist&lt;/td&gt;&lt;td&gt;MinXray sim → MWL server&lt;/td&gt;&lt;td&gt;DICOM MWL C-FIND :9003 · AE MIX&lt;/td&gt;&lt;td&gt;working&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;④&lt;/td&gt;&lt;td&gt;Exposure started&lt;/td&gt;&lt;td&gt;MinXray sim → MWL server&lt;/td&gt;&lt;td&gt;DICOM MPPS N-CREATE (IN PROGRESS) :9003&lt;/td&gt;&lt;td&gt;working&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;⑤&lt;/td&gt;&lt;td&gt;Progress shown in qTrack&lt;/td&gt;&lt;td&gt;MWL server → Platform API&lt;/td&gt;&lt;td&gt;HTTP POST /patients/&amp;lt;id&amp;gt;/ (mpps_progress)&lt;/td&gt;&lt;td&gt;working&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;⑥&lt;/td&gt;&lt;td&gt;Primary image&lt;/td&gt;&lt;td&gt;MinXray sim → dcmio&lt;/td&gt;&lt;td&gt;DICOM C-STORE DX For Presentation · MIX → QUREAI :5252&lt;/td&gt;&lt;td&gt;working&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;⑥b&lt;/td&gt;&lt;td&gt;&lt;i&gt;(retired)&lt;/i&gt; primary sent directly to the PACS&lt;/td&gt;&lt;td&gt;MinXray sim → AdvaPACS Gateway&lt;/td&gt;&lt;td&gt;DICOM C-STORE · MINX_DX_01 → QURE01_GW_01&lt;/td&gt;&lt;td&gt;off since 2026-10-07; replaced by ⑭&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;⑦&lt;/td&gt;&lt;td&gt;Exposure done; item leaves worklist&lt;/td&gt;&lt;td&gt;MinXray sim → MWL server&lt;/td&gt;&lt;td&gt;DICOM MPPS N-SET (COMPLETED) :9003&lt;/td&gt;&lt;td&gt;working&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;⑧&lt;/td&gt;&lt;td&gt;Filter, validate, upload&lt;/td&gt;&lt;td&gt;dcmio → Platform API&lt;/td&gt;&lt;td&gt;HTTP :8080&lt;/td&gt;&lt;td&gt;working&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;⑨&lt;/td&gt;&lt;td&gt;AI inference&lt;/td&gt;&lt;td&gt;Platform API ↔ qXR&lt;/td&gt;&lt;td&gt;HTTP :8180 · GPU&lt;/td&gt;&lt;td&gt;working&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;⑩&lt;/td&gt;&lt;td&gt;Results stored: DX (JPEG), SC ×2, Encapsulated PDF, Basic Text SR&lt;/td&gt;&lt;td&gt;Platform API → storage&lt;/td&gt;&lt;td&gt;filestore + postgres :5432&lt;/td&gt;&lt;td&gt;working&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;⑪&lt;/td&gt;&lt;td&gt;Study and qXR report in patient channel&lt;/td&gt;&lt;td&gt;Platform API ↔ qTrack UI&lt;/td&gt;&lt;td&gt;HTTP :8080 · WebSocket :8081&lt;/td&gt;&lt;td&gt;working&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;⑫&lt;/td&gt;&lt;td&gt;Sync patients, images, reports&lt;/td&gt;&lt;td&gt;qsync → qTrack Cloud&lt;/td&gt;&lt;td&gt;HTTPS, store-and-forward&lt;/td&gt;&lt;td&gt;production install; lab clone needs own identity&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;⑬&lt;/td&gt;&lt;td&gt;Collect the completed study: lossless primary + qXR objects + patient sex/DOB&lt;/td&gt;&lt;td&gt;MinXray output, storage → PACS adapter&lt;/td&gt;&lt;td&gt;shared folder · filestore (read-only) · SQL :5432 as imladris_ro&lt;/td&gt;&lt;td&gt;working&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;⑭&lt;/td&gt;&lt;td&gt;Normalized study: DX + SC ×2 + Encapsulated PDF + SR&lt;/td&gt;&lt;td&gt;PACS adapter → AdvaPACS Gateway&lt;/td&gt;&lt;td&gt;DICOM C-STORE · QURE01_ADP_01 → QURE01_GW_01 :11112&lt;/td&gt;&lt;td&gt;working&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;⑮&lt;/td&gt;&lt;td&gt;Upload to cloud PACS (queues while offline)&lt;/td&gt;&lt;td&gt;AdvaPACS Gateway → AdvaPACS Cloud&lt;/td&gt;&lt;td&gt;HTTPS (usa1)&lt;/td&gt;&lt;td&gt;working&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
