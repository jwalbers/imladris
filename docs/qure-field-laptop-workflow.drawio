<mxfile host="Electron" pages="1">
  <diagram name="Qure field laptop workflow" id="qure-field-laptop-workflow">
    <mxGraphModel dx="1735" dy="1224" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" value="Qure.ai field laptop — MinXray capture → qXR → qTrack Cloud &amp;amp; AdvaPACS (MWL and DICOM transactions ①–⑮)" vertex="1">
          <mxGeometry height="40" width="1640" x="40" y="10" as="geometry" />
        </mxCell>

        <!-- Outer swimlane: the laptop -->
        <mxCell id="lap" parent="1" style="swimlane;startSize=40;fillColor=#d0cee2;strokeWidth=2;dashed=1;dashPattern=8 8;fontSize=14;fontStyle=1;swimlaneLine=1;align=right;strokeColor=#56517e;" value="Qure.ai field laptop — Docker Desktop (WSL2) · works offline" vertex="1">
          <mxGeometry height="970" width="1640" x="40" y="60" as="geometry" />
        </mxCell>

        <!-- Footer bar -->
        <mxCell id="foot" parent="lap" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=20;align=right;" value="QURE01 · Qure.ai App on-prem stack + IMLADRIS agents  " vertex="1">
          <mxGeometry height="50" width="1600" x="20" y="905" as="geometry" />
        </mxCell>

        <!-- ROW A -->
        <mxCell id="tech" parent="lap" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" value="&lt;b&gt;Health worker / Rad Tech&lt;/b&gt;&lt;br&gt;Browser Client&lt;br&gt;&lt;hr/&gt;qTrack UI :3000&lt;br&gt;Register patient&lt;br&gt;Review image + qXR report" vertex="1">
          <mxGeometry height="150" width="200" x="30" y="70" as="geometry" />
        </mxCell>

        <mxCell id="ui" parent="lap" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6d0de;strokeColor=#996185;strokeWidth=2;fontSize=11;align=center;verticalAlign=middle;arcSize=8;gradientColor=#d5739d;" value="&lt;b&gt;qTrack Web UI&lt;/b&gt;&lt;br&gt;Docker · qure-app-frontend&lt;br&gt;&lt;hr/&gt;Port 3000 HTTP&lt;br&gt;Add Patient · worklist · patient channel · viewer&lt;br&gt;&lt;br&gt;&lt;i&gt;MWL mode: NEXT_PUBLIC_IS_MWL_ENABLED=true&lt;br&gt;(runtimeConfig.js)&lt;/i&gt;" vertex="1">
          <mxGeometry height="180" width="260" x="290" y="55" as="geometry" />
        </mxCell>

        <mxCell id="mwl" parent="lap" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6d0de;strokeColor=#996185;strokeWidth=2;fontSize=11;align=center;verticalAlign=middle;arcSize=8;gradientColor=#d5739d;" value="&lt;b&gt;Modality Worklist server&lt;/b&gt;&lt;br&gt;Docker · mwl (qureai/dicom-scp) + postgres_mwl&lt;br&gt;&lt;hr/&gt;Port 9003 → 222  DICOM: MWL C-FIND, MPPS&lt;br&gt;Port 9002 → 4000  HTTP: /patient/add, /patient/upsert&lt;br&gt;Implicit VR LE only · accepts any AE&lt;br&gt;&lt;br&gt;REGISTERED → IN PROGRESS → COMPLETED&lt;br&gt;C-FIND returns REGISTERED items only&lt;br&gt;&lt;i&gt;Items: Modality DX · Scheduled Station AE MIX&lt;/i&gt;" vertex="1">
          <mxGeometry height="220" width="340" x="610" y="45" as="geometry" />
        </mxCell>

        <mxCell id="qsync" parent="lap" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6d0de;strokeColor=#996185;strokeWidth=2;dashed=1;fontSize=11;align=center;verticalAlign=middle;arcSize=8;gradientColor=#d5739d;" value="&lt;b&gt;qsync — cloud sync&lt;/b&gt;&lt;br&gt;Docker · qsync (qure_platform_api send)&lt;br&gt;&lt;hr/&gt;Store-and-forward to qTrack Cloud&lt;br&gt;patients · images · qXR reports&lt;br&gt;&lt;br&gt;&lt;i&gt;Enabled on the production install;&lt;br&gt;off on the lab clone (needs its own identity)&lt;/i&gt;" vertex="1">
          <mxGeometry height="170" width="290" x="1300" y="60" as="geometry" />
        </mxCell>

        <!-- ROW B -->
        <mxCell id="minx" parent="lap" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" value="&lt;b&gt;MinXray detector simulator&lt;/b&gt;&lt;br&gt;Docker · minxray-agent (IMLADRIS)&lt;br&gt;&lt;hr/&gt;AE MIX (worklist, MPPS, dcmio)&lt;br&gt;Keeps a lossless copy of every capture&lt;br&gt;Polls the worklist every 15 s → auto-capture&lt;br&gt;PNG → synthetic DX For Presentation&lt;br&gt;2304×2816 @ 0.154 mm · 16-bit · MONOCHROME2&lt;br&gt;MTF blur · Poisson + electronic noise · UTF-8&lt;br&gt;&lt;br&gt;&lt;i&gt;Emulates dicomPACS DX-R + CareRay CareView 1500Cw&lt;br&gt;Source: tb-cxr library · Bophelong census&lt;/i&gt;" vertex="1">
          <mxGeometry height="270" width="310" x="30" y="330" as="geometry" />
        </mxCell>

        <mxCell id="dcmio" parent="lap" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6d0de;strokeColor=#996185;strokeWidth=2;fontSize=11;align=center;verticalAlign=middle;arcSize=8;gradientColor=#d5739d;" value="&lt;b&gt;dcmio DICOM gateway&lt;/b&gt;&lt;br&gt;Docker · dcmio_dicom_server · dcmio_worker&lt;br&gt;&lt;hr/&gt;Port 5252 DICOM C-STORE SCP (AE QUREAI)&lt;br&gt;Port 7000 web / config API&lt;br&gt;DX · CR · SC · any AE · common TS&lt;br&gt;&lt;br&gt;filter → validate → upload → compute → publish&lt;br&gt;&lt;i&gt;DICOM publishers: none configured&lt;/i&gt;" vertex="1">
          <mxGeometry height="230" width="290" x="400" y="350" as="geometry" />
        </mxCell>

        <mxCell id="api" parent="lap" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6d0de;strokeColor=#996185;strokeWidth=2;fontSize=11;align=center;verticalAlign=middle;arcSize=8;gradientColor=#d5739d;" value="&lt;b&gt;Qure Platform API&lt;/b&gt;&lt;br&gt;Docker · qureapi (+ workers, ws, nginx)&lt;br&gt;&lt;hr/&gt;Port 8080 HTTP API · 8081 WebSocket&lt;br&gt;Port 2001 nginx&lt;br&gt;Patients · studies · reports · workflow&lt;br&gt;Stores primary as JPEG (q90)&lt;br&gt;&lt;br&gt;&lt;i&gt;sc_generation_api: SC overlays · PDF report&lt;/i&gt;" vertex="1">
          <mxGeometry height="230" width="290" x="750" y="350" as="geometry" />
        </mxCell>

        <mxCell id="qxr" parent="lap" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6d0de;strokeColor=#996185;strokeWidth=2;fontSize=11;align=center;verticalAlign=middle;arcSize=8;gradientColor=#d5739d;" value="&lt;b&gt;qXR inference&lt;/b&gt;&lt;br&gt;Docker · cathode-api · cathode-worker&lt;br&gt;&lt;hr/&gt;Port 8180 HTTP (cathode API)&lt;br&gt;GPU: NVIDIA RTX 1000 Ada (6 GB)&lt;br&gt;qXR v4 · 26 models&lt;br&gt;≈30 s per study (≈3 min cold start)&lt;br&gt;&lt;br&gt;Findings · TB score · CTR" vertex="1">
          <mxGeometry height="230" width="270" x="1110" y="350" as="geometry" />
        </mxCell>

        <!-- ROW C -->
        <mxCell id="store" parent="lap" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" value="&lt;b&gt;Platform storage&lt;/b&gt;&lt;br&gt;postgres :5432 · volume prod-data&lt;br&gt;&lt;hr/&gt;DB: patients · studies · series · images · sync state&lt;br&gt;Filestore /srv/data/hct/&amp;lt;workspace&amp;gt;/&amp;lt;SeriesUID&amp;gt;/&lt;br&gt;· original — DX (JPEG q90)&lt;br&gt;· _sc.dcm · _sc_without_sidebar.dcm — SC overlays&lt;br&gt;· _sr.dcm — Basic Text SR&lt;br&gt;· _reports/*.dcm — Encapsulated PDF" vertex="1">
          <mxGeometry height="220" width="340" x="700" y="650" as="geometry" />
        </mxCell>

        <mxCell id="adapter" parent="lap" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" value="&lt;b&gt;IMLADRIS PACS adapter&lt;/b&gt;&lt;br&gt;Docker · pacs-adapter · AE QURE01_ADP_01&lt;br&gt;&lt;hr/&gt;Watches for studies qXR has finished&lt;br&gt;Primary: MinXray lossless DX · qXR: 2 SC, SR, PDF&lt;br&gt;Normalizes before AdvaPACS:&lt;br&gt;· valid UIDs · accession ≤ 16 chars&lt;br&gt;· PatientName Family^Given · sex · DOB&lt;br&gt;· StudyDate / Description on every object&lt;br&gt;· UTF-8 (ISO_IR 192) · synthetic marker&lt;br&gt;&lt;br&gt;&lt;i&gt;DB access: read-only role imladris_ro&lt;/i&gt;" vertex="1">
          <mxGeometry height="220" width="290" x="1080" y="650" as="geometry" />
        </mxCell>

        <mxCell id="gw" parent="lap" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#FF8000;strokeWidth=2;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" value="&lt;b&gt;AdvaPACS Gateway&lt;/b&gt;&lt;br&gt;Docker · advapacs-gateway&lt;br&gt;(qure01-gw-01)&lt;br&gt;&lt;hr/&gt;Port 11112 DICOM C-STORE SCP&lt;br&gt;Local AE QURE01_GW_01&lt;br&gt;Port 8085 DICOMweb proxy&lt;br&gt;Calling AE: QURE01_ADP_01&lt;br&gt;&lt;br&gt;Store-and-forward queue (volume)&lt;br&gt;&lt;i&gt;uploads when online&lt;/i&gt;" vertex="1">
