        <mxCell id="h3" value="Rad Tech / Sidecar" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#d6b656;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="70" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="h4" value="Modality Simulator" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="70" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="h5" value="Cloud PACS (Orthanc)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="920" y="70" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="h6" value="Radiologist" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1140" y="70" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="h7" value="Qure.ai Sim / AdvaPACS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#FF8000;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1360" y="70" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="&lt;b&gt;1. Order Imaging&lt;/b&gt;&lt;br&gt;Select patient, choose&lt;br&gt;study type in OpenMRS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="150" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;2. Create MWL Entry&lt;/b&gt;&lt;br&gt;Radiology Module generates&lt;br&gt;DICOM Worklist record" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="280" y="150" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s2b" value="&lt;b&gt;3. Sidecar Polls Orders&lt;/b&gt;&lt;br&gt;REST poll → writes .wl file&lt;br&gt;to shared worklist volume" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#d6b656;strokeWidth=2;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="500" y="270" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;4. Query Worklist (C-FIND)&lt;/b&gt;&lt;br&gt;Pull pending exams from&lt;br&gt;Modality MWL SCP :4242" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#d6b656;strokeWidth=2;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="500" y="390" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="&lt;b&gt;5. Trigger Acquisition&lt;/b&gt;&lt;br&gt;Select patient on modality,&lt;br&gt;initiate image capture" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#d6b656;strokeWidth=2;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="500" y="510" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="&lt;b&gt;6. Push DICOM to Modality&lt;/b&gt;&lt;br&gt;Sidecar sends CXR from&lt;br&gt;Bophelong fictional dataset" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="720" y="510" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="&lt;b&gt;7. C-STORE to PACS&lt;/b&gt;&lt;br&gt;Modality pushes study&lt;br&gt;to Orthanc PACS :4243" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="720" y="630" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s7" value="&lt;b&gt;8. Index + Lua Forward&lt;/b&gt;&lt;br&gt;PACS stores study&lt;br&gt;Triggers Qure-sim + AdvaPACS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="940" y="630" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s7b" value="&lt;b&gt;9. AI + Cloud Forward&lt;/b&gt;&lt;br&gt;Qure-sim → SC annotation&lt;br&gt;AdvaPACS GW → Cloud (usa1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#FF8000;strokeWidth=2;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1380" y="630" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s8" value="&lt;b&gt;10. Mark Study Received&lt;/b&gt;&lt;br&gt;PACS watcher sends HL7 ORU&lt;br&gt;Order status updated in EMR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="280" y="750" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s9" value="&lt;b&gt;11. Fetch Study (WADO-RS)&lt;/b&gt;&lt;br&gt;OHIF retrieves DICOM images&lt;br&gt;from PACS via DICOMweb" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1160" y="750" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s10" value="&lt;b&gt;12. Read + Score&lt;/b&gt;&lt;br&gt;Cavity size, WHO CXR score&lt;br&gt;Views AI SC alongside DX" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1160" y="870" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s11" value="&lt;b&gt;13. Submit Report&lt;/b&gt;&lt;br&gt;HL7 ORU / FHIR DiagnosticReport&lt;br&gt;signed &amp;amp; stored in OpenMRS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="280" y="870" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s12" value="&lt;b&gt;14. View Images + AI Result&lt;/b&gt;&lt;br&gt;OHIF read-only DICOMweb&lt;br&gt;incl. qXR AI Analysis SC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="990" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s13" value="&lt;b&gt;15. Review Report&lt;/b&gt;&lt;br&gt;Access signed radiology report&lt;br&gt;and patient record in OpenMRS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="280" y="990" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s14" value="&lt;b&gt;16. Clinical Decision&lt;/b&gt;&lt;br&gt;Drug regimen adjustment,&lt;br&gt;referral, or follow-up order" style="shape=mxgraph.flowchart.terminate;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="1090" width="180" height="60" as="geometry" />
        </mxCell>
