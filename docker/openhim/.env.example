# Lab settings for OpenHIM + the AdvaPACS mediator (see README.md). Copy to .env; never commit .env.
# Values here override openmrs-contrib-distro-tools/docker/services/*.env.defaults.
SERVICE_NAME=openhim

# Ports: router moved off 5001 (the lab's modality console) and kept on localhost: nothing outside
# the VM needs it yet, and the mediator's outbound channel is public by design.
OPENHIM_ROUTER_HTTP_HOST_PORT=127.0.0.1:5011
OPENHIM_ADMIN_API_HOST_PORT=8081
OPENHIM_CONSOLE_HOST_PORT=9000

# Where the browser reaches the console and the admin API (the console calls the API directly).
# LAN bring-up:
OPENHIM_CONSOLE_URL=http://192.168.3.66:9000
OPENHIM_CONSOLE_API_PROTOCOL=http
OPENHIM_CONSOLE_API_HOST=192.168.3.66
OPENHIM_CONSOLE_API_PORT=8081
# Behind HAProxy (both https), e.g.:
# OPENHIM_CONSOLE_URL=https://openhim.imladrislab.org
# OPENHIM_CONSOLE_API_PROTOCOL=https
# OPENHIM_CONSOLE_API_HOST=openhim-api.imladrislab.org
# OPENHIM_CONSOLE_API_PORT=443

OPENHIM_PASSWORD=

# Mediator: deployed but idle. "push" waits for OpenMRS to push orders, which the lab's
# OpenMRS doesn't do; lab orders keep going over HL7 from the sidecar (docs/openhim-migration-plan.md).
ADVAPACS_MEDIATOR_ORDER_INGESTION_MODE=push
ADVAPACS_MEDIATOR_IMAGE_TAG=latest
ADVAPACS_MEDIATOR_INBOUND_SECRET=
ADVAPACS_MEDIATOR_OPENHIM_INBOUND_CLIENT_PASSWORD=
OPENMRS_BASE_URL=http://host.docker.internal:8080/openmrs
OPENMRS_USERNAME=imladris-service
OPENMRS_PASSWORD=
ADVAPACS_PATIENT_IDENTIFIER_SYSTEM=http://www.pih.org/identifiers/lesotho/emr-id
ADVAPACS_CLIENT_ID=
ADVAPACS_CLIENT_SECRET=
ADVAPACS_WEBHOOK_SECRET=
