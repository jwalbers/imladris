// Orthanc configuration — Imladris Cloud PACS
// AE title: IML_PACS_01   HTTP: 8042 (exposed as 8043)   DICOM: 4242 (exposed as 4243)
{
  "Name"                  : "Imladris Cloud PACS",
  "DicomAet"              : "IML_PACS_01",
  "DicomPort"             : 4242,
  "HttpPort"              : 8042,

  // Allow connections from any host (lab environment — not for production)
  "RemoteAccessAllowed"   : true,
  "AuthenticationEnabled" : false,

  // Accept C-STORE for any SOP class
  "UnknownSopClassAccepted" : true,

  // Do not reject associations whose Called AET doesn't match ours
  "DicomCheckCalledAet"   : false,

  // Known remote modalities
  "DicomModalities" : {
    "MODALITY_SIM"   : ["MODALITY_SIM",   "orthanc-modality", 4242],
    // Simulated Qure.ai qXR DCMIO gateway
    "QUREAI"         : ["QUREAI",         "qure-sim",         5252],
    // AdvaPACS Gateway — host-networked C-STORE SCP on this lab host (Local AE configured in
    // AdvaPACS cloud admin). AE title comes from the compose env (ADVAPACS_GW_AE: _01 Oregon, _02 Wisconsin).
    "${ADVAPACS_GW_AE}" : ["${ADVAPACS_GW_AE}", "host.docker.internal", 11112]
  },

  // Enable bundled plugins (Stone Web Viewer + DICOMweb)
  "Plugins" : ["/usr/share/orthanc/plugins/"],

  // CORS — allow OHIF (localhost:3000) to query the DICOMweb API
  "HttpAllowCors" : true,
  "HttpAllowedOrigins" : ["*"],
  "HttpAllowedHeaders" : ["Authorization", "Content-Type"],
  "HttpAllowedMethods" : ["GET", "POST", "PUT", "DELETE", "OPTIONS"],

  // DICOMweb plugin — required for OHIF (WADO-RS / QIDO-RS / STOW-RS)
  "DicomWeb" : {
    "Enable"     : true,
    "Root"       : "/dicom-web/",
    "EnableWado" : true,
    "WadoRoot"   : "/wado",
    // Transcode frames to uncompressed on retrieval so /frames/N works
    "TranscodeDicomWebRequestsToUncompressed" : true,

    // No STOW-RS servers: Orthanc never forwards to AdvaPACS (decided 2026-10-02).
    // Studies that should be in AdvaPACS are sent there deliberately, by hand.
    "Servers" : {}
  },

  // Auto-forward: lab CXR instances → Qure.ai simulator (local only).
  // lab-guard.lua must load first: it defines IsLabStudy(), which blocks real PHI.
  "LuaScripts" : [
    "/etc/orthanc/lab-guard.lua",
    "/etc/orthanc/forward-to-qure.lua"
  ],

  // GDCM — allow transcoding all transfer syntaxes for frame retrieval
  "Gdcm" : {
    "Enable" : true,
    "RestrictTransferSyntaxes" : []
  },
  "OrthancExplorer2" : {
    "Enable" : true,
    "IsDefaultOrthancUI" : true,
    "UiOptions" : {
      "ShowOrthancName" : true
    }
  }
}
