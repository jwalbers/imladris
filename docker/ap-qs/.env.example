# ap-qs lab stack — copy to .env (git-ignored) and fill in. Never commit .env.
#
# ── Site identity ───────────────────────────────────────────────────────────
# Each site has its own AdvaPACS gateway, Local AE and modality AE titles, so
# both labs can share the AdvaPACS tenant. Blank = Oregon (_01) defaults.
#   Oregon    (BESSIE):          gateway imladris-gw-01, AE suffix _01
#   Wisconsin (PANGU lab VM):    gateway imladris-gw-02, AE suffix _02
# The AE titles must match the Local AE's Accepted Calling AEs in the AdvaPACS portal.
ADVAPACS_GW_AE=ADVAPACS_GW_02
LAB_CR_AET=IML_CR_02
LAB_US_AET=IML_US_02
LAB_CT_AET=IML_CT_02
LAB_TOOLS_AET=IML_TOOLS_02
LAB_TZ=America/Chicago
LAB_SITE_NAME=Wisconsin

# ── AdvaPACS gateway (this site's gateway key, from the portal) ─────────────
ADVAPACS_GW_KEY_ID=
ADVAPACS_GW_SECRET=

# ── AdvaPACS API (FHIR, DICOMweb proxy) ─────────────────────────────────────
ADVAPACS_KEY_ID=
ADVAPACS_SECRET=
# base64 of KEY_ID:SECRET, for the OHIF CORS proxy
ADVAPACS_AUTH_B64=
ADVAPACS_WEBHOOK_SECRET=

# ── OpenMRS REST service account (no 2FA) ───────────────────────────────────
OPENMRS_SERVICE_USER=imladris-service
OPENMRS_SERVICE_PASSWORD=

# ── SimpleSAMLphp SP ────────────────────────────────────────────────────────
# openssl rand -base64 32
SAML_SP_SECRETSALT=
SAML_ADMIN_PASSWORD=

# ── Databases ───────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# ── Paths (Linux host) ──────────────────────────────────────────────────────
# qure-sim annotated PNG library (absolute Linux path)
SAMPLE_DIR_HOST=
