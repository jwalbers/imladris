# Copy to .env (git-ignored). Never commit .env.

# head -c 64 /dev/urandom | tr -dc A-Za-z0-9 | head -c 24
GUAC_DB_PASSWORD=
# replaces the default guacadmin/guacadmin
GUAC_ADMIN_PASSWORD=

# Qure.ai laptop (single-user appliance; demo account)
QURE_RDP_HOST=192.168.3.70
QURE_RDP_USER=dev
QURE_RDP_PASSWORD=

# Guacamole users allowed to use the Qure laptop (space-separated). setup.sh gives
# each a random initial password, printed once; they enroll TOTP at first sign-in.
GUAC_USERS=
