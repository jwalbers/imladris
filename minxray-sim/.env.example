# Copy to .env (git-ignored); docker compose reads it automatically.
# Site settings for where this simulated detector is running — the device AE
# (FORWARD_AE) stays the same wherever it moves; the gateway target is local.

# Source images and census (paths relative to this folder)
LIBRARY_HOST=../../imladris-data/raw/tb-cxr/set-1
CENSUS_DIR=../../imladris-bophelong/patients

# Forward each capture to the AdvaPACS gateway as this device's AE
FORWARD_TO=QURE01_GW_01@advapacs-gateway:11112
FORWARD_AE=MINX_DX_01
